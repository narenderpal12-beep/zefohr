{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "npm run dev --workspace=@workspace/peoplehub",
    "start": "npm run start --workspace=@workspace/peoplehub",
    "db:migrate": "npm run db:migrate --workspace=@workspace/peoplehub-core",
    "db:seed": "npm run db:seed --workspace=@workspace/peoplehub-core",
    "db:setup": "npm run db:setup --workspace=@workspace/peoplehub-core",
    "build": "npm run typecheck && npm run build --workspace=@workspace/api-server && npm run build --workspace=@workspace/peoplehub",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs && npm run typecheck --workspaces --if-present"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "workspaces": ["artifacts/*", "lib/*", "lib/integrations/*", "scripts"],
  "overrides": {"esbuild": "0.28.2", "react": "19.1.0", "react-dom": "19.1.0"},   
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "~5.9.3"
  }
}
